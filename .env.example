# =============================================================================
# Practical 7: Authentication and Middleware Pipeline
# Task Management Full Stack Application (React + Express + MongoDB + JWT)
# CHARUSAT ITUE301 - Ansh Sojitra (24CS095)
# Environment Configuration Template
# =============================================================================

# --- Backend Configuration (backend/.env) ---
# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (loaded via dotenv, never hardcoded)
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/task_manager
# MongoDB Atlas (Cloud) Example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/task_manager?retryWrites=true&w=majority

# JWT Authentication Secret Key (MANDATORY - never commit real secret)
JWT_SECRET=your_jwt_secret_key_here

# JWT Token Expiration (e.g., 1h, 24h, 7d)
JWT_EXPIRES_IN=1h

# --- Frontend Configuration (frontend/.env) ---
# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:5000

