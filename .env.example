# =============================================================================
# Full-Stack TaskFlow Application - Environment Configuration Template
# Practicals 9-12: CHARUSAT ITUE301 - Ansh Sojitra (24CS095)
# React (Vite) + Express + MongoDB + Docker Compose + In-Memory Caching + Events
# =============================================================================

# --- Backend Configuration (backend/.env) ---
PORT=5000
NODE_ENV=development

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String:
# Local development outside Docker:
MONGO_URI=mongodb://127.0.0.1:27017/task_manager
# Docker Compose internal service-to-service communication:
# MONGO_URI=mongodb://mongodb:27017/task_manager

# JWT Authentication Secret Key (MANDATORY - do NOT commit secrets)
JWT_SECRET=supersecret_jwt_key_charusat_24cs095_practical11
JWT_EXPIRES_IN=1h

# In-Memory Cache TTL (Practical 9) in seconds
CACHE_TTL_SECONDS=60

# --- Frontend Configuration (frontend/.env) ---
# NOTE ON NETWORKING: The frontend application executes in the client's web browser,
# which resides OUTSIDE the internal Docker network. Therefore, the browser must reach
# the backend API through the host-mapped port (http://localhost:5000), not the internal
# container hostname (http://backend:5000).
VITE_API_BASE_URL=http://localhost:5000

# --- Docker Compose Environment ---
# Compose Project Name
COMPOSE_PROJECT_NAME=taskflow-stack
