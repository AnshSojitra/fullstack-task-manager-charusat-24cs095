# =============================================================================
# Task Manager REST API - Environment Configuration Template
# Practical 7: Authentication and Middleware Pipeline
# CHARUSAT ITUE301 - Ansh Sojitra (24CS095)
# =============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (loaded via dotenv, never hardcoded)
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/task_manager
# MongoDB Atlas (Cloud) Example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/task_manager?retryWrites=true&w=majority

# JWT Authentication Secret Key (MANDATORY - do NOT use hardcoded fallbacks)
# Set to a strong, high-entropy secret in your private .env file
JWT_SECRET=your_jwt_secret_key_here

# JWT Token Expiration Time (e.g., 1h, 24h, 7d)
JWT_EXPIRES_IN=1h

# In-Memory Cache TTL (Practical 9) in seconds
CACHE_TTL_SECONDS=60

